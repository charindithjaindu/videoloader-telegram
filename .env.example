# Telegram Bot Configuration
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Proxy Configuration (Optional)
# Leave empty to disable proxy
# Supported formats: socks5://host:port, http://host:port
PROXY_HOST=localhost
PROXY_PORT=40000
PROXY_TYPE=socks5

# Logger Channel Configuration
# Channel or group ID to forward download logs (use negative value for channels/groups)
# Leave empty to disable logging
LOGGER_CHANNEL_ID=-1001234567890

# Admin User IDs (comma-separated)
# These users won't be logged in the logger channel
# Example: ADMINS=123456789,987654321
ADMINS=
