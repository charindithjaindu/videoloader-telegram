# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# From https://my.telegram.org/apps (used by the local telegram-bot-api server)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Random string; the local Bot API server sends it with every webhook call
WEBHOOK_SECRET=change-me
# Where the local Bot API server delivers updates (internal Docker network)
WEBHOOK_URL=http://bot:8080/webhook

# --- Limits ---
# Max simultaneous yt-dlp/ffmpeg runs across ALL worker replicas (8-20)
DOWNLOAD_CONCURRENCY=10
# arq jobs per worker process
WORKER_MAX_JOBS=10
WORKER_REPLICAS=2
MAX_JOBS_PER_USER=3
LINKS_PER_MINUTE=10
PROGRESS_INTERVAL=4

# --- Optional ---
# Comma-separated Telegram user ids. Admins can use /stats, aren't logged to the
# logger channel, and skip the per-user limits (LINKS_PER_MINUTE, MAX_JOBS_PER_USER)
ADMINS=2086729495
# Channel/group id that gets a copy of each new download (bot must be admin there)
LOGGER_CHANNEL_ID=
# Proxy for yt-dlp, e.g. socks5://warp:40000
PROXY_URL=
